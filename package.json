{
  "name": "wowd",
  "version": "0.1.5",
  "description": "Word ライクな日本語文書エディタ",
  "main": "./out/main/index.js",
  "author": {
    "name": "IsamuTakiguchi",
    "email": "IsamuTakiguchi@users.noreply.github.com"
  },
  "desktopName": "wowd.desktop",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "templates": "tsx scripts/make-templates.ts",
    "fixtures": "npm run templates && tsx scripts/make-fixtures.ts && tsx scripts/make-ooxml-fixtures.ts",
    "verify:roundtrip": "tsx scripts/verify-roundtrip.ts",
    "word-check": "tsx scripts/make-word-check.ts",
    "schema:fetch": "tsx scripts/fetch-ooxml-schema.ts",
    "schema:validate": "tsx scripts/validate-ooxml.ts",
    "e2e": "playwright test",
    "icon": "tsx scripts/make-icon.ts",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "test:web": "playwright test --config playwright.web.config.ts",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "5.0.1",
    "docx": "9.7.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.5.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "zustand": "5.0.15"
  }
}
